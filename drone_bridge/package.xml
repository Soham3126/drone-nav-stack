<?xml version="1.0"?>
<package format="3">
  <name>drone_bridge</name>
  <version>0.1.0</version>
  <description>Bridge between ROS 2 and ArduPilot (guidebook 2.9): pose to EKF3, flight commands, frame-offset tracking, carrot path follower</description>
  <maintainer email="soham@example.com">Soham Majhi</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>drone_interfaces</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
