<?xml version="1.0"?>
<package format="3">
  <name>drone_frontier</name>
  <version>0.1.0</version>
  <description>Frontier server (guidebook 2.7): finds the edges between explored free space and unknown space in /map, ranks them, publishes /frontiers once a second</description>
  <maintainer email="soham@example.com">Soham Majhi</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>drone_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
