# sitl_base.parm (always loaded) - guidebook 2.9. Copter 4.7 parameter names, SI units.
RNGFND1_TYPE    100     # SITL rangefinder (height from the simulator); gazebo-iris's analog sonar read 0 (first B1/B2 run)
RNGFND1_ORIENT  25      # pointing down
RNGFND1_MIN     0.05
RNGFND1_MAX     8
PLND_ENABLED    0       # gazebo-iris enables precision landing; not used
WP_SPD          0.5     # Guided-mode speed, m/s (Copter 4.7)
