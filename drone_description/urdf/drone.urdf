<?xml version="1.0"?>
<!-- Sensor mounting positions (guidebook 2.3). Must match drone_sim/models/iris_with_lidar. -->
<robot name="drone">
  <link name="base_link"/>
  <link name="laser"/>
  <link name="imu_link"/>
  <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>
  <joint name="base_link_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>
</robot>
