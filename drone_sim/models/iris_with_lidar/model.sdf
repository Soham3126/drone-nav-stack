<?xml version="1.0"?>
<!-- Guidebook 4.2. The iris (with ArduPilot plugin, rotors, lift-drag) comes from
     ardupilot_gazebo's iris_with_ardupilot; we only add the LiDAR, the IMU for
     Cartographer and the ground-truth odometry publisher. -->
<sdf version="1.9">
  <model name="iris_with_lidar">
    <include merge="true">
      <uri>model://iris_with_ardupilot</uri>
    </include>
    <link name="lidar_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial><mass>0.11</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>laser</gz_frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan><horizontal><samples>500</samples><resolution>1</resolution>
             <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.015</stddev></noise>
        </lidar>
      </sensor>
      <sensor name="imu_carto" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>imu</topic>
        <update_rate>200</update_rate>
        <always_on>1</always_on>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>lidar_link</child>
    </joint>
    <plugin filename="gz-sim-odometry-publisher-system"
             name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/ground_truth/odom</odom_topic>
    </plugin>
  </model>
</sdf>
