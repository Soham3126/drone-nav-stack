<?xml version="1.0"?>
<!-- Guidebook 4.2. The iris (with ArduPilot plugin, rotors, lift-drag) comes from
     ardupilot_gazebo's iris_with_ardupilot; we only add the LiDAR, the IMU for
     Cartographer and the ground-truth odometry publisher. -->
<sdf version="1.9">
  <model name="iris_with_lidar">
    <include merge="true">
      <uri>model://iris_with_ardupilot</uri>
    </include>
    <link name="lidar_link">
      <pose>0 0 0.12 0 0 0</pose>
      <inertial><mass>0.11</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz></inertia></inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>laser</gz_frame_id>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan><horizontal><samples>500</samples><resolution>1</resolution>
             <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.05</min><max>12.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.02</stddev></noise>   <!-- RPLIDAR C1: +-30 mm class accuracy -->
        </lidar>
      </sensor>
      <!-- Downward rangefinder, stand-in for the MTF-01P's ToF (BOM): one beam, 0.02-8 m, 20 Hz.
           1.5708 pitch turns the beam from +x to straight down; it sits 5 cm below base_link. -->
      <sensor name="range_down" type="gpu_lidar">
        <pose>0 0 -0.17 0 1.5708 0</pose>
        <gz_frame_id>range_down</gz_frame_id>
        <topic>range_down</topic>
        <update_rate>20</update_rate>
        <always_on>1</always_on>
        <lidar>
          <scan><horizontal><samples>1</samples><resolution>1</resolution>
             <min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.02</min><max>8.0</max><resolution>0.001</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.005</stddev></noise>
        </lidar>
      </sensor>
      <sensor name="imu_carto" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <topic>imu</topic>
        <update_rate>200</update_rate>
        <always_on>1</always_on>
        <imu>
          <!-- MPU6500 (BOM): gyro ~0.01 deg/s/sqrtHz -> 0.0017 rad/s at 100 Hz bandwidth; residual bias after
               start-up calibration ~0.02 deg/s. Accel ~300 ug/sqrtHz -> 0.03 m/s^2; residual bias ~0.05 m/s^2. -->
          <angular_velocity><x><noise type="gaussian"><mean>0</mean><stddev>0.0017</stddev><bias_mean>0.0003</bias_mean><bias_stddev>0.0001</bias_stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.0017</stddev><bias_mean>0.0003</bias_mean><bias_stddev>0.0001</bias_stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.0017</stddev><bias_mean>0.0003</bias_mean><bias_stddev>0.0001</bias_stddev></noise></z></angular_velocity>
          <linear_acceleration><x><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.01</bias_stddev></noise></x><y><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.01</bias_stddev></noise></y><z><noise type="gaussian"><mean>0</mean><stddev>0.03</stddev><bias_mean>0.05</bias_mean><bias_stddev>0.01</bias_stddev></noise></z></linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>lidar_link</child>
    </joint>
    <plugin filename="gz-sim-odometry-publisher-system"
             name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/ground_truth/odom</odom_topic>
    </plugin>
  </model>
</sdf>
